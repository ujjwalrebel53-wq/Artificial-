<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:gravity="top">

    <!-- AI Avatar -->
    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:text="🤖"
        android:textSize="20sp"
        android:gravity="center"
        android:background="@drawable/bg_gradient_avatar"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Rebel AI" android:textSize="12sp" android:textColor="@color/rebel_purple_light"
                 android:layout_marginEnd="8dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Rebel GPT-5" android:textSize="10sp" android:textColor="@color/rebel_purple_light"
                android:background="@drawable/bg_model_badge_small" android:paddingHorizontal="6dp" android:paddingVertical="2dp"
                android:layout_marginEnd="8dp" android:alpha="0.7"/>
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/text_muted"/>
        </LinearLayout>

        <!-- Message Bubble -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:background="@drawable/bg_msg_ai"
            android:padding="14dp" />

        <!-- Response time + Actions -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView android:id="@+id/tvResponseTime" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="10sp" android:textColor="@color/text_muted"
                android:visibility="gone" />

            <!-- Action Buttons -->
            <ImageButton android:id="@+id/btnCopy" android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_copy" android:background="?selectableItemBackgroundBorderless"
                android:tint="@color/text_muted" android:contentDescription="Copy" android:layout_marginEnd="4dp"/>
            <ImageButton android:id="@+id/btnThumbUp" android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_thumb_up" android:background="?selectableItemBackgroundBorderless"
                android:tint="@color/text_muted" android:contentDescription="Like" android:layout_marginEnd="4dp"/>
            <ImageButton android:id="@+id/btnThumbDown" android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_thumb_down" android:background="?selectableItemBackgroundBorderless"
                android:tint="@color/text_muted" android:contentDescription="Dislike"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
