<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── MAIN CONTENT ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary">

        <!-- Sidebar overlay -->
        <View
            android:id="@+id/sidebarOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ── SIDEBAR ── -->
        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/sidebar_bg"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Sidebar Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:paddingTop="52dp">

                <!-- New Chat Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewChat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="+ New conversation"
                    android:textSize="14sp"
                    android:backgroundTint="@color/bg_hover"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/sidebar_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Conversation list -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConversations"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:clipToPadding="false" />

            <!-- Sidebar Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:paddingBottom="24dp"
                android:background="@color/sidebar_bg">

                <include layout="@layout/item_sidebar_footer_btn"
                    android:id="@+id/btnVoiceAssistant" />

                <!-- User Profile -->
                <LinearLayout
                    android:id="@+id/btnUserProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvUserAvatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="U"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_bold"
                        android:background="@drawable/bg_gradient_avatar"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="User" android:textSize="13sp" android:textColor="@color/text_primary" android:fontFamily="@font/inter_semibold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Free Plan" android:textSize="11sp" android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/text_muted" android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── CHAT AREA ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Chat Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:background="@color/bg_primary"
                android:paddingTop="12dp">

                <ImageButton
                    android:id="@+id/btnToggleSidebar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_menu"
                    android:background="?selectableItemBackgroundBorderless"
                    android:tint="@color/text_muted"
                    android:contentDescription="Toggle sidebar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_model_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_green" android:layout_marginEnd="7dp" />
                    <TextView android:id="@+id/tvModelName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Rebel GPT-5"
                        android:textSize="13sp" android:textColor="@color/text_primary"
                        android:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnVoiceInput"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_mic"
                    android:background="?selectableItemBackgroundBorderless"
                    android:tint="@color/text_muted"
                    android:contentDescription="Voice input" />
            </LinearLayout>

            <!-- Messages list -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Welcome Screen -->
                <ScrollView
                    android:id="@+id/welcomeScreen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="24dp"
                        android:paddingTop="60dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🤖" android:textSize="56sp" android:layout_marginBottom="20dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="How can I help you?" android:textSize="24sp"
                            android:fontFamily="@font/space_grotesk_bold" android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ask anything — Powered by Rebel GPT-5" android:textSize="14sp"
                            android:textColor="@color/text_muted" android:layout_marginBottom="36dp" />

                        <!-- Suggestion Cards -->
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="2"
                            android:useDefaultMargins="true">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionCode"
                                style="@style/SuggestionCard"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="6dp"
                                android:layout_marginBottom="12dp"
                                android:clickable="true"
                                android:focusable="true">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="vertical" android:padding="14dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="💻" android:textSize="20sp" android:layout_marginBottom="8dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Write Python code" android:textSize="13sp"
                                        android:fontFamily="@font/inter_semibold" android:textColor="@color/text_primary"
                                        android:layout_marginBottom="4dp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Sort list of dicts by key" android:textSize="11sp"
                                        android:textColor="@color/text_muted" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionFact"
                                style="@style/SuggestionCard"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="6dp"
                                android:layout_marginBottom="12dp"
                                android:clickable="true"
                                android:focusable="true">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="vertical" android:padding="14dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="🧠" android:textSize="20sp" android:layout_marginBottom="8dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="AI Fun Fact" android:textSize="13sp"
                                        android:fontFamily="@font/inter_semibold" android:textColor="@color/text_primary"
                                        android:layout_marginBottom="4dp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Interesting AI history" android:textSize="11sp"
                                        android:textColor="@color/text_muted" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionCode2"
                                style="@style/SuggestionCard"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="6dp"
                                android:clickable="true"
                                android:focusable="true">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="vertical" android:padding="14dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="🎨" android:textSize="20sp" android:layout_marginBottom="8dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="CSS Tips" android:textSize="13sp"
                                        android:fontFamily="@font/inter_semibold" android:textColor="@color/text_primary"
                                        android:layout_marginBottom="4dp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Center div 3 ways" android:textSize="11sp"
                                        android:textColor="@color/text_muted" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/suggestionMotivate"
                                style="@style/SuggestionCard"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="6dp"
                                android:clickable="true"
                                android:focusable="true">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="vertical" android:padding="14dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="⚡" android:textSize="20sp" android:layout_marginBottom="8dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Motivate Me" android:textSize="13sp"
                                        android:fontFamily="@font/inter_semibold" android:textColor="@color/text_primary"
                                        android:layout_marginBottom="4dp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Powerful quote" android:textSize="11sp"
                                        android:textColor="@color/text_muted" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </GridLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- Messages RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- ── CHAT INPUT AREA ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:paddingBottom="24dp"
                android:background="@color/bg_primary">

                <!-- Image Preview Bar -->
                <LinearLayout
                    android:id="@+id/imagePreviewBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_input_box"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">
                    <ImageView android:id="@+id/ivImagePreview" android:layout_width="50dp"
                        android:layout_height="50dp" android:scaleType="centerCrop"
                        android:background="@drawable/bg_image_thumb"
                        android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Image attached"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <ImageButton android:id="@+id/btnRemoveImage" android:layout_width="28dp"
                        android:layout_height="28dp" android:src="@drawable/ic_close"
                        android:background="@drawable/bg_remove_img_btn" android:tint="@color/rebel_red"
                        android:contentDescription="Remove image" />
                </LinearLayout>

                <!-- Input Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:background="@drawable/bg_input_box"
                    android:padding="10dp">

                    <ImageButton
                        android:id="@+id/btnAttach"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_attach"
                        android:background="?selectableItemBackgroundBorderless"
                        android:tint="@color/text_muted"
                        android:contentDescription="Attach image"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/etChatInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/message_rebel_ai"
                        android:hintTextColor="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:background="@null"
                        android:minLines="1"
                        android:maxLines="6"
                        android:inputType="textMultiLine|textCapSentences"
                        android:imeOptions="actionSend"
                        android:paddingHorizontal="4dp" />

                    <ImageButton
                        android:id="@+id/btnVoiceInputChat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_mic"
                        android:background="?selectableItemBackgroundBorderless"
                        android:tint="@color/text_muted"
                        android:contentDescription="Voice input"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/rebel_purple"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_send"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_primary"
                        android:enabled="false"
                        android:alpha="0.5"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Send message" />
                </LinearLayout>

                <!-- Footer -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Enter to send" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:id="@+id/tvCharCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0/4000"
                        android:textSize="11sp" android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.drawerlayout.widget.DrawerLayout>
