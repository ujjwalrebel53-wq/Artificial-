<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bottom Sheet Theme -->
    <style name="BottomSheetTheme" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    </style>
    <style name="CustomBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/bg_secondary</item>
        <item name="shapeAppearance">@style/BottomSheetShape</item>
    </style>
    <style name="BottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
</resources>
